package {
    default_applicable_licenses: ["arrow_sdk_license"],
}

license {
    name: "arrow_sdk_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

// Arrow CC sources.
filegroup {
    name: "arrow_sdk_sources",
    srcs: [
        "src/**/*.java",
    ],
    visibility: ["//frameworks/base/packages/SystemUI:__subpackages__"],
}

// Arrow CC resources.
android_library {
    name: "arrow_sdk_res",
    manifest: "AndroidManifest.xml",
    resource_dirs: ["res"],
    visibility: ["//visibility:public"],
}

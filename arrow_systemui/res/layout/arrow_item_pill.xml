<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/arrow_pill_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/arrow_bg_cc_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp">

        <ImageView
            android:id="@+id/arrow_pill_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:tint="@color/arrow_cc_icon" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="@color/arrow_cc_outline" />

        <TextView
            android:id="@+id/arrow_pill_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/arrow_cc_text_primary"
            android:textSize="14sp"
            android:fontFamily="google-sans-medium" />
    </LinearLayout>

    <ImageView
        android:id="@+id/arrow_badge"
        android:layout_width="@dimen/arrow_cc_badge"
        android:layout_height="@dimen/arrow_cc_badge"
        android:layout_gravity="top|start"
        android:background="@drawable/arrow_bg_cc_badge"
        android:contentDescription="@string/arrow_remove"
        android:padding="4dp"
        android:src="@drawable/arrow_ic_remove"
        android:tint="@color/arrow_cc_badge_on_badge"
        android:visibility="gone" />
</FrameLayout>
